<UserControl x:Class="TradeIt.Views.SymbolIdentityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="مدیریت شناسه‌ها" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="جدید" Width="60" Margin="3" Click="NewButton_Click"/>
                <Button Content="ذخیره" Width="60" Margin="3" Click="SaveButton_Click"/>
                <Button Content="حذف انتخاب‌شده" Width="100" Margin="3" Click="DeleteSelectedButton_Click"/>
                <Button Content="حذف کامل" Width="75" Margin="3" Click="DeleteAllButton_Click"/>
                <Button Content="Import از Excel" Width="105" Margin="3" Click="ImportExcelButton_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="کد 12 رقمی نماد" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SymbolId12TextBox" Grid.Row="0" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="1" Text="کد 5 رقمی نماد" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SymbolCode5TextBox" Grid.Row="1" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="2" Text="نام لاتین شرکت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="CompanyNameLatinTextBox" Grid.Row="2" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="3" Text="کد 4 رقمی شرکت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="CompanyCode4TextBox" Grid.Row="3" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="4" Text="نام شرکت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="CompanyNameTextBox" Grid.Row="4" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="5" Text="نماد فارسی" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SymbolNameFaTextBox" Grid.Row="5" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="6" Text="نماد 30 رقمی فارسی" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SymbolName30FaTextBox" Grid.Row="6" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="7" Text="کد 12 رقمی شرکت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="CompanyId12TextBox" Grid.Row="7" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="8" Text="بازار" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="MarketTextBox" Grid.Row="8" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="9" Text="کد تابلو" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="BoardCodeTextBox" Grid.Row="9" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="10" Text="کد گروه صنعت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="IndustryCodeTextBox" Grid.Row="10" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="11" Text="گروه صنعت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="IndustryNameTextBox" Grid.Row="11" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="12" Text="کد زیرگروه صنعت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SubIndustryCodeTextBox" Grid.Row="12" Grid.Column="1" Margin="2" Height="27"/>
                    <TextBlock Grid.Row="13" Text="زیرگروه صنعت" Margin="2" VerticalAlignment="Center"/><TextBox x:Name="SubIndustryNameTextBox" Grid.Row="13" Grid.Column="1" Margin="2" Height="27"/>
                </Grid>
            </ScrollViewer>
            <DataGrid x:Name="IdentitiesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="IdentitiesDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد 12 رقمی نماد" Binding="{Binding SymbolId12}" Width="115"/>
                    <DataGridTextColumn Header="کد 5 رقمی" Binding="{Binding SymbolCode5}" Width="80"/>
                    <DataGridTextColumn Header="نام شرکت" Binding="{Binding CompanyName}" Width="*"/>
                    <DataGridTextColumn Header="نماد" Binding="{Binding SymbolNameFa}" Width="90"/>
                    <DataGridTextColumn Header="بازار" Binding="{Binding Market}" Width="75"/>
                    <DataGridTextColumn Header="صنعت" Binding="{Binding IndustryName}" Width="120"/>
                    <DataGridTextColumn Header="زیرگروه" Binding="{Binding SubIndustryName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="آماده" Margin="2,6,2,0" Foreground="#555555"/>
    </Grid>
</UserControl>