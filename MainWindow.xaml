<Window x:Class="TradeIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TradeIt"
        mc:Ignorable="d"
        Title="TradeIt" Height="700" Width="1200" MinHeight="500" MinWidth="900" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_SymbolGroupsCollapseLoaded">
    <Window.Resources>
        <local:TradeDateConverter x:Key="TradeDateConverter"/>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="37*"/><ColumnDefinition Width="1163*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="TopToolbarRow" Height="55"/><RowDefinition x:Name="MainContentRow" Height="*"/><RowDefinition x:Name="StatusBarRow" Height="30"/></Grid.RowDefinitions>
        <Border x:Name="TopToolbar" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Background="#F5F5F5">
            <Grid Margin="10,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SymbolsColumn" Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="سبد:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="PortfolioComboBox" Grid.Column="1" Height="32" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="PortfolioComboBox_SelectionChanged"/>
                <Button x:Name="ManagePortfolioButton" Grid.Column="2" Content="مدیریت سبدها" Height="32" Padding="15,0" Margin="10,0,8,0" Click="ManagePortfolioButton_Click"/>
                <Button x:Name="NewPortfolioButton" Grid.Column="3" Content="+ تعریف سبد" Height="32" Padding="15,0" Margin="0,0,8,0" Click="NewPortfolioButton_Click"/>
                <Button x:Name="RefreshPortfolioButton" Grid.Column="4" Content="بازخوانی" Height="32" Padding="15,0" Margin="0,0,8,0" Click="RefreshPortfolioButton_Click"/>
                <Button x:Name="ChartSettingsButton" Grid.Column="5" Content="تنظیمات چارت" Height="32" Padding="15,0" Margin="0,0,8,0" Click="ChartSettingsButton_Click"/>
                <Button x:Name="FullScreenButton" Grid.Column="8" Content="⛶ تمام صفحه" Height="32" Padding="15,0" Margin="10,0,0,0" Click="FullScreenButton_Click"/>
            </Grid>
        </Border>
        <Grid x:Name="MainContent" Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SymbolsPanelColumn" Width="300"/><ColumnDefinition x:Name="ChartPanelColumn" Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                <Grid x:Name="SymbolsGroupsContainer">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="SymbolTableGroup" Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Button x:Name="SymbolTableCollapseButton" Grid.Row="0" Content="▲" Height="24" HorizontalAlignment="Right" Click="SymbolTableCollapseButton_Click"/>
                            <DataGrid x:Name="SymbolsDataGrid" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="SymbolsDataGrid_SelectionChanged"/>
                        </Grid>
                    </Border>
                    <Border x:Name="SymbolFilterGroup" Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="SymbolFilterHost" Grid.Row="0"/>
                            <Button x:Name="SymbolFilterCollapseButton" Grid.Row="1" Content="▲" Height="24" HorizontalAlignment="Right" Click="SymbolFilterCollapseButton_Click"/>
                        </Grid>
                    </Border>
                    <Border x:Name="SymbolOperationsGroup" Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="SymbolOperationsContent" Grid.Row="0"/>
                            <Button x:Name="SymbolOperationsCollapseButton" Grid.Row="1" Content="▲" Height="24" HorizontalAlignment="Right" Click="SymbolOperationsCollapseButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                <Grid>
                    <Button x:Name="SymbolsPanelCollapseButton" Content="‹" Width="24" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SymbolsPanelCollapseButton_Click"/>
                    <TabControl x:Name="ChartTabs" Margin="25,0,0,0" SelectionChanged="ChartTabs_SelectionChanged"/>
                </Grid>
            </Border>
        </Grid>
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2"><TextBlock x:Name="StatusTextBlock"/></StatusBar>
    </Grid>
</Window>