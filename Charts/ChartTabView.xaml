<UserControl x:Class="TradeIt.Charts.ChartTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinWidth="600"
             MinHeight="350">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MainChartRow"
                           Height="*" />
            <RowDefinition x:Name="VolumeChartRow"
                           Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- Toolbar -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1"
                Background="White">

            <WrapPanel Margin="5">

                <!-- Chart Type -->

                <TextBlock Text="نوع نمودار:"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0" />

                <ComboBox x:Name="ChartTypeComboBox"
                          Width="130"
                          Height="28"
                          Margin="0,0,8,0"
                          SelectionChanged="ChartTypeComboBox_SelectionChanged">

                    <ComboBoxItem Content="کندل"
                                  Tag="Candlestick" />

                    <ComboBoxItem Content="خطی"
                                  Tag="Line" />

                    <ComboBoxItem Content="میله‌ای"
                                  Tag="Bar" />

                </ComboBox>


                <!-- Volume -->

                <Button x:Name="VolumeButton"
                        Content="نمایش حجم"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="VolumeButton_Click" />


                <!-- Grid -->

                <Button x:Name="GridButton"
                        Content="GRID"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="GridButton_Click" />


                <!-- Crosshair -->

                <Button x:Name="CrosshairButton"
                        Content="Crosshair روشن"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="CrosshairButton_Click" />


                <!-- Zoom In -->

                <Button Content="Zoom +"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="ZoomInButton_Click" />


                <!-- Zoom Out -->

                <Button Content="Zoom -"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="ZoomOutButton_Click" />


                <!-- Reset -->

                <Button Content="Reset Zoom"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="ResetZoomButton_Click" />


                <!-- Full View -->

                <Button Content="نمای کامل"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="FullViewButton_Click" />


                <!-- Hide Chart -->

                <Button x:Name="HideChartButton"
                        Content="پنهان کردن نمودار"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="HideChartButton_Click" />


                <!-- Hide Tools -->

                <Button x:Name="HideToolsButton"
                        Content="پنهان کردن ابزارهای تکنیکال"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="HideToolsButton_Click" />


                <!-- Settings -->

                <Button Content="تنظیمات"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="SettingsButton_Click" />


                <!-- Screenshot -->

                <Button Content="تصویر"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="ScreenshotButton_Click" />


                <!-- Print -->

                <Button Content="چاپ"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        Click="PrintButton_Click" />

            </WrapPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- Main Price Chart -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                BorderBrush="LightGray"
                BorderThickness="1"
                Margin="2">

            <Grid>

                <ScottPlot:WpfPlot x:Name="Chart" />

                <!-- Information at top-right -->
                <TextBlock x:Name="ChartInfoTextBlock"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="10"
               Padding="6,3"
               Background="#DDFFFFFF"
               Foreground="Black"
               FontSize="12"
               IsHitTestVisible="False" />

                <!-- Warning for invalid market data -->
                <TextBlock x:Name="InvalidDataWarningTextBlock"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="10"
               Padding="8,4"
               Background="#DDFFFFFF"
               Foreground="Red"
               FontWeight="Bold"
               FontSize="12"
               Text="⚠ این چارت دارای داده‌های نامعتبر است. داده‌های نامعتبر با خط قرمز مشخص شده‌اند."
               Visibility="Collapsed"
               IsHitTestVisible="False" />

            </Grid>
        </Border>


        <!-- ===================================================== -->
        <!-- Volume Chart -->
        <!-- ===================================================== -->

        <Border x:Name="VolumeContainer"
                Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                Margin="2"
                Visibility="Collapsed">

            <Grid>

                <ScottPlot:WpfPlot x:Name="VolumeChart" />

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- Bottom Information -->
        <!-- ===================================================== -->

        <Border Grid.Row="3"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,0"
                Background="White">

            <TextBlock x:Name="BottomInfoTextBlock"
                       Margin="8,4"
                       Text=""
                       Foreground="DimGray"
                       FontSize="12" />

        </Border>

    </Grid>

</UserControl>