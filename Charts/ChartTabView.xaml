<UserControl x:Class="TradeIt.Charts.ChartTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinWidth="600" MinHeight="350"
             Loaded="ChartOhlcOverlay_Loaded">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ChartAreaRow" Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chart toolbar. Main-window chart settings remains outside this control. -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Background="White">
            <WrapPanel Margin="5" VerticalAlignment="Center">
                <ComboBox x:Name="ChartTypeComboBox"
                          Width="110"
                          Margin="0,0,5,0"
                          SelectionChanged="ChartTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="کندل" Tag="Candlestick" IsSelected="True" />
                    <ComboBoxItem Content="خطی" Tag="Line" />
                    <ComboBoxItem Content="میله‌ای" Tag="Bar" />
                </ComboBox>
                <Button x:Name="VolumeButton" Content="نمایش حجم" Margin="0,0,5,0" Click="VolumeButton_Click" />
                <Button x:Name="GridButton" Content="GRID" Margin="0,0,5,0" Click="GridButton_Click" />
                <Button x:Name="CrosshairButton" Content="Crosshair روشن" Margin="0,0,5,0" Click="CrosshairButton_Click" />
                <Button x:Name="HideChartButton" Content="پنهان کردن نمودار" Margin="0,0,5,0" Click="HideChartButton_Click" />
                <Button x:Name="HideToolsButton" Content="پنهان کردن ابزارهای تکنیکال" Margin="0,0,5,0" Click="HideToolsButton_Click" />
                <Button Content="+" Width="32" Margin="0,0,3,0" Click="ZoomInButton_Click" />
                <Button Content="−" Width="32" Margin="0,0,5,0" Click="ZoomOutButton_Click" />
                <Button Content="بازنشانی" Margin="0,0,5,0" Click="ResetZoomButton_Click" />
                <Button Content="تصویر" Margin="0,0,5,0" Click="ScreenshotButton_Click" />
                <Button Content="چاپ" Margin="0,0,5,0" Click="PrintButton_Click" />
            </WrapPanel>
        </Border>

        <Grid x:Name="ChartPrintArea" Grid.Row="1" Background="White" MouseMove="ChartPrintArea_MouseMove" MouseLeave="ChartPrintArea_MouseLeave">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition x:Name="MainChartRow" Height="*" />
                <RowDefinition x:Name="VolumeChartRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Header belongs to the chart capture/print area. -->
            <Grid Grid.Row="0" Margin="8,5,8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChartTitleTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="Black" />
                <TextBlock x:Name="ChartOhlcTextBlock"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="Black" />
                <TextBlock x:Name="InvalidDataWarningTextBlock"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,25,0,0"
                           Visibility="Collapsed"
                           FontSize="11"
                           Foreground="Red"
                           Text="داده نامعتبر / بازه بدون معامله" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="2">
                <Grid>
                    <ScottPlot:WpfPlot x:Name="Chart" />
                    <TextBlock x:Name="ChartInfoTextBlock" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border x:Name="VolumeContainer" Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Margin="2" Visibility="Collapsed">
                <Grid>
                    <ScottPlot:WpfPlot x:Name="VolumeChart" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Background="White">
            <TextBlock x:Name="BottomInfoTextBlock" Margin="8,4" Text="" Foreground="DimGray" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
