<Window x:Class="TradeIt.Portfolios.PortfolioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعریف سبد" Width="1100" Height="900" MinWidth="950" MinHeight="750"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="نام سبد:" VerticalAlignment="Center"/>
            <TextBox x:Name="PortfolioNameTextBox" Grid.Column="1" Height="28"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="منبع نام نماد" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton x:Name="SymbolFromFileNameRadio" Content="نام فایل" IsChecked="True" Margin="0,0,35,0"/>
                    <RadioButton x:Name="SymbolFromFileContentRadio" Content="داخل فایل"/>
                </StackPanel>
            </GroupBox>
            <TextBlock Grid.Column="1" Text="منبع داده: فایل‌های موجود در مسیر انتخاب‌شده" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <TextBlock Text="مسیر داده:" VerticalAlignment="Center"/>
            <TextBox x:Name="PathTextBox" Grid.Column="1" Height="28"/>
            <Button x:Name="BrowseButton" Grid.Column="2" Content="انتخاب پوشه..." Height="28" Margin="10,0,0,0" Click="BrowseButton_Click"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="جداکننده:" VerticalAlignment="Center"/>
            <ComboBox x:Name="DelimiterComboBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Comma (,)" Tag=","/><ComboBoxItem Content="Tab" Tag="&#9;"/>
                <ComboBoxItem Content="Semicolon (;)" Tag=";"/><ComboBoxItem Content="Pipe (|)" Tag="|"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="تقویم:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CalendarComboBox" Grid.Column="3" SelectedIndex="0">
                <ComboBoxItem Content="شمسی (Persian)" Tag="Persian"/><ComboBoxItem Content="میلادی (Gregorian)" Tag="Gregorian"/>
            </ComboBox>
            <CheckBox x:Name="HeaderCheckBox" Grid.Column="4" Content="سطر اول عنوان ستون‌هاست" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="NoDateTimeCheckBox" Content="داده فاقد تاریخ/زمان است" VerticalAlignment="Center" Checked="NoDateTimeCheckBox_Changed" Unchecked="NoDateTimeCheckBox_Changed"/>
                    <TextBlock Grid.Column="1" Text="فرمت تاریخ:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DateFormatComboBox" Grid.Column="2" SelectedIndex="0">
                        <ComboBoxItem Content="YYYYMMDD" Tag="yyyyMMdd"/><ComboBoxItem Content="YYYY-MM-DD" Tag="yyyy-MM-dd"/>
                        <ComboBoxItem Content="YYYY/MM/DD" Tag="yyyy/MM/dd"/><ComboBoxItem Content="DD/MM/YYYY" Tag="dd/MM/yyyy"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="فرمت زمان:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TimeFormatComboBox" Grid.Column="4" SelectedIndex="0">
                        <ComboBoxItem Content="HHMMSS" Tag="HHmmss"/><ComboBoxItem Content="HH:MM:SS" Tag="HH:mm:ss"/>
                        <ComboBoxItem Content="HHMM" Tag="HHmm"/><ComboBoxItem Content="HH:MM" Tag="HH:mm"/>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Mapping ستون‌ها" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Symbol:" Grid.Row="0"/><ComboBox x:Name="SymbolColumnCombo" Grid.Row="0" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Date:" Grid.Row="1"/><ComboBox x:Name="DateColumnCombo" Grid.Row="1" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Time:" Grid.Row="2"/><ComboBox x:Name="TimeColumnCombo" Grid.Row="2" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Open:" Grid.Row="3"/><ComboBox x:Name="OpenColumnCombo" Grid.Row="3" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="High:" Grid.Row="4"/><ComboBox x:Name="HighColumnCombo" Grid.Row="4" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Low:" Grid.Row="5"/><ComboBox x:Name="LowColumnCombo" Grid.Row="5" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Close:" Grid.Row="6"/><ComboBox x:Name="CloseColumnCombo" Grid.Row="6" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="Volume:" Grid.Row="7"/><ComboBox x:Name="VolumeColumnCombo" Grid.Row="7" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="پایانی امروز:" Grid.Row="8"/><ComboBox x:Name="TSECloseColumnCombo" Grid.Row="8" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="پایانی دیروز:" Grid.Row="9"/><ComboBox x:Name="PreviousColumnCombo" Grid.Row="9" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="ارزش معامله:" Grid.Row="10"/><ComboBox x:Name="ValueColumnCombo" Grid.Row="10" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="تعداد معامله:" Grid.Row="11"/><ComboBox x:Name="TradeCountColumnCombo" Grid.Row="11" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="نماد انگلیسی:" Grid.Row="12"/><ComboBox x:Name="EnglishTickerColumnCombo" Grid.Row="12" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="تعداد سهام:" Grid.Row="13"/><ComboBox x:Name="ShareCountColumnCombo" Grid.Row="13" Grid.Column="1" Margin="5"/>
                                <TextBlock Text="ارزش بازار:" Grid.Row="14"/><ComboBox x:Name="MarketValueColumnCombo" Grid.Row="14" Grid.Column="1" Margin="5"/>
                            </Grid>
                        </ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="انتخاب سهام">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SymbolFilterTextBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" ToolTip="برای فیلتر نماد تایپ کنید" TextChanged="SymbolFilterTextBox_TextChanged"/>
                                <TextBlock Grid.Column="0" Text="جستجوی نماد..." IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button x:Name="SelectAllSymbolsButton" Content="انتخاب همه" Width="100" Height="30" Margin="0,0,8,0" Click="SelectAllSymbolsButton_Click"/>
                                    <Button x:Name="DeselectAllSymbolsButton" Content="عدم انتخاب همه" Width="110" Height="30" Click="DeselectAllSymbolsButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="SymbolSelectionGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="نماد" Binding="{Binding Symbol}" SortMemberPath="Symbol" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
            <GroupBox Grid.Row="1" Header="پیش‌نمایش داده" Margin="0,0,0,0">
                <DataGrid x:Name="PreviewDataGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True" Margin="5"/>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="تست Mapping" Width="120" Height="32" Margin="0,0,10,0" Click="TestButton_Click"/>
            <Button Content="ذخیره سبد" Width="120" Height="32" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="لغو" Width="80" Height="32" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>